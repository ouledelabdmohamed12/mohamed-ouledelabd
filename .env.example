# Cloudflare Turnstile site key (public, safe to expose in the frontend).
# Production requires a real site key. The test-key fallback is development-only.
VITE_TURNSTILE_SITE_KEY=

# EmailJS private key — used server-side only by /api/contact (no VITE_ prefix,
# so Vite never bundles it into client code). Set this in your Vercel project's
# environment variables. Get it from https://dashboard.emailjs.com/admin/account
EMAILJS_PRIVATE_KEY=

# Meta (Facebook) Pixel ID for the Facebook/Instagram ad campaigns.
# Leave empty and no pixel script is loaded at all and no events are sent.
# Note the VITE_ prefix: Vite only exposes VITE_-prefixed variables to client
# code, so a NEXT_PUBLIC_-prefixed name would never reach the browser.
# Find the ID in Meta Events Manager > Data sources.
VITE_META_PIXEL_ID=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Same rules as the pixel above: leave it empty and no GA4 script is loaded.
# Find it in Google Analytics > Admin > Data streams > your web stream.
VITE_GA4_ID=
# Server-only configuration; never prefix these secrets with VITE_.
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames accepted by the API. Add a preview hostname for staging.
TURNSTILE_ALLOWED_HOSTNAMES=kodaatlas.com,www.kodaatlas.com
# Optional overrides: defaults preserve the existing EmailJS service/template.
EMAILJS_SERVICE_ID=service_prx83vw
EMAILJS_TEMPLATE_ID=template_bbujlih
EMAILJS_PUBLIC_KEY=SAbE7J_X_PEmfaP8h

# Legacy analytics script in index.html; public measurement ID.
# If analytics are used, keep this aligned with VITE_GA4_ID.
VITE_GA_ID=
