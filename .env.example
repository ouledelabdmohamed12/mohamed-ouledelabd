# Contact: public widget key, included in the frontend build.
VITE_TURNSTILE_SITE_KEY=

# Server-only secrets. NEVER prefix these with VITE_.
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated verified hostnames. Add your exact Preview hostname in
# Cloudflare and here when testing a Vercel Preview deployment.
TURNSTILE_ALLOWED_HOSTNAMES=kodaatlas.com,www.kodaatlas.com

# Optional: notification inbox and Auto-Reply Reply-To.
# Reception is managed separately by Cloudflare Email Routing to Gmail.
CONTACT_NOTIFICATION_EMAIL=contact@kodaatlas.com

# Optional public analytics IDs (unrelated to email delivery).
VITE_META_PIXEL_ID=
VITE_GA4_ID=
# Legacy index.html analytics ID; keep aligned with VITE_GA4_ID when used.
VITE_GA_ID=
