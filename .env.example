# Cloudflare Turnstile site key (public, safe to expose in the frontend).
# Get yours at https://dash.cloudflare.com/?to=/:account/turnstile — until then
# the site falls back to Cloudflare's public test key (always passes).
VITE_TURNSTILE_SITE_KEY=

# EmailJS private key — used server-side only by /api/contact (no VITE_ prefix,
# so Vite never bundles it into client code). Set this in your Vercel project's
# environment variables. Get it from https://dashboard.emailjs.com/admin/account
EMAILJS_PRIVATE_KEY=
